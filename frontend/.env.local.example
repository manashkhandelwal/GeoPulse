# GeoPulse Frontend Environment Variables (Optional)
# Copy this file to .env.local if you need to configure frontend-specific variables

# Backend API URL (if applicable)
# NEXT_PUBLIC_API_URL=http://localhost:5000

# Neo4j connection details (if connecting directly from frontend)
# NEXT_PUBLIC_NEO4J_URI=bolt://localhost:7687
# NEXT_PUBLIC_NEO4J_USER=neo4j
# NEXT_PUBLIC_NEO4J_PASSWORD=your-password

# MongoDB connection (if connecting directly from frontend)
# NEXT_PUBLIC_MONGODB_URI=mongodb://localhost:27017/geopulse

# Note: NEXT_PUBLIC_ prefix makes variables available in the browser
# Only add sensitive data if absolutely necessary and understand the security implications
